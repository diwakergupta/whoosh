{
  "name": "whoosh",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun test",
    "build:bundle": "bun build src/cli.ts --target bun --outfile dist/whoosh.js",
    "build:bin": "bun build --compile --outfile dist/whoosh src/cli.ts",
    "build": "bun run build:bin"
  },
  "dependencies": {
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
